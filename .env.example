# Nothing here is required: `frames preview` and `frames render` run entirely
# on your machine. This file names variables — it never carries a value, and a
# real secret never belongs in a .env. Credentials come from Hanzo KMS
# (kms.hanzo.ai) at run time.

# Tool paths, when the bundled binaries are not what you want to run:
# FRAMES_FFMPEG_PATH=
# FRAMES_FFPROBE_PATH=
# FRAMES_BROWSER_PATH=

# Anonymous usage reporting is on; set to 1 to switch it off:
# FRAMES_NO_TELEMETRY=

# Hosted speech, transcription, and vision go through api.hanzo.ai/v1 with a
# key issued by Hanzo IAM (hanzo.id) and read from KMS — not from here.
