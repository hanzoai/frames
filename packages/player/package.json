{
  "name": "@hanzo/frames-player",
  "version": "0.7.83",
  "description": "Embeddable web component for Frames compositions",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/frames",
    "directory": "packages/player"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/frames-player.js",
  "types": "./dist/frames-player.d.ts",
  "exports": {
    ".": {
      "types": "./dist/frames-player.d.ts",
      "script": "./dist/frames-player.global.js",
      "import": "./dist/frames-player.js",
      "require": "./dist/frames-player.cjs"
    },
    "./slideshow": {
      "types": "./dist/slideshow/frames-slideshow.d.ts",
      "script": "./dist/slideshow/frames-slideshow.global.js",
      "import": "./dist/slideshow/frames-slideshow.js",
      "require": "./dist/slideshow/frames-slideshow.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/verify-runtime-pin.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/perf/tsconfig.json",
    "test": "vitest run",
    "perf": "bun run tests/perf/index.ts"
  },
  "dependencies": {
    "@hanzo/frames-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "gsap": "^3.12.5",
    "puppeteer-core": "^25.2.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
